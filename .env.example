# ==============================================================================
# ai-dev-playbook (Trellis) - Environment Variables Template
# ==============================================================================
# SECURITY BASELINE:
# - Copy this file to `.env` for local development (`cp .env.example .env`).
# - NEVER commit `.env` or real credentials to version control.
# - NEVER place real secrets or tokens inside CLAUDE.md, GEMINI.md, rules, or skills.
# ==============================================================================

# Example application environment
APP_ENV=development

# Database access for MCP / local tools (prefer read-only access per security baseline)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=example_db
DB_USER=readonly_user_placeholder
DB_PASSWORD=replace_with_local_placeholder_only
DB_READONLY=true

# External tool / MCP placeholders (DO NOT put real tokens here)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_placeholder_here
TICKETING_API_TOKEN=your_ticketing_token_placeholder_here

# Private VM HTTP MCP Server authentication & multi-key registry ([REQ-MCP-05..08])
# Either set TRELLIS_API_KEY manually or start with `--serve-http --auto-generate-key`
# Generate a key for another user/team with: python -m trellis_mcp --generate-key <team-name> --role member
TRELLIS_API_KEY=replace_with_admin_or_team_bearer_api_key_placeholder
TRELLIS_KEYS_FILE=.trellis_keys.json
TRELLIS_PORT=8080

# Optional transport/bundle hardening
# TRELLIS_TLS_CERT=C:\Trellis\server.crt
# TRELLIS_TLS_KEY=C:\Trellis\server.key
# Shared HMAC key used to sign /bundle.json & /install.sh (clients verify with the same value)
# TRELLIS_BUNDLE_SIGNING_KEY=replace_with_shared_signing_key_placeholder
