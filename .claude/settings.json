{
  "_comment": "Claude Code project security baseline ([REQ-TRL-07, REQ-TRL-26]). Pattern-based deny rules and PreToolUse/Stop hooks act as a defense-in-depth safety net; pair with allowlists and OS/container sandboxing for hard isolation.",
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.trellis_keys.json)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(curl *-d *)",
      "Bash(wget *--post*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/validate-bash.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/secret-scan.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/run-tests.sh"
          }
        ]
      }
    ]
  }
}
